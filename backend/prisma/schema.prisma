generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  password     String
  avatar       String?
  roles        Json      @default("[\"user\"]")
  position     String?
  provider     String?
  providerId   String?   @unique @map("provider_id")
  isVerified   Boolean   @default(false) @map("is_verified")
  resetToken   String?   @map("reset_token")
  resetExpires DateTime? @map("reset_expires")
  otpCode      String?   @map("otp_code")
  otpExpires   DateTime? @map("otp_expires")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens         RefreshToken[]
  workspaceMemberships  WorkspaceMember[]
  createdDocuments      Document[]       @relation("DocumentCreator")
  createdTemplates      Template[]       @relation("TemplateCreator")
  files                 File[]
  sources               Source[]
  chatMessages          ChatMessage[]
  customFields          UserCustomField[]
  articles              Article[]
  payments              Payment[]
  userCredit            UserCredit?
  documentVersions      DocumentVersion[]
  tabularReviews        TabularReview[]
  lpmsChats             LpmsChat[]

  @@map("users")
}

model Article {
  id          String    @id @default(uuid())
  type        String    // 'news' | 'policy' | 'document' | 'announcement'
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     Json?
  contentText String?   @db.LongText
  coverImage  String?   @map("cover_image")
  status      String    @default("draft")
  publishedAt DateTime? @map("published_at")
  authorId    String?   @map("author_id")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([publishedAt])
  @@map("articles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  companyCode String?  @unique @map("company_code") @db.VarChar(20)
  logo        String?
  plan        String   @default("free")
  settings    Json     @default("{}")
  quotaLimits Json?    @map("quota_limits")
  aiConfig    Json?    @map("ai_config")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members        WorkspaceMember[]
  documents      Document[]
  files          File[]
  sources        Source[]
  payments       Payment[]
  customFields   WorkspaceCustomField[]
  templates      Template[]
  projects       Project[]
  obligations    Obligation[]
  tabularReviews TabularReview[]
  lpmsChats      LpmsChat[]

  @@map("workspaces")
}

model WorkspaceCustomField {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  key          String   @db.VarChar(80)
  label        String
  defaultValue String?  @db.Text @map("default_value")
  isHidden     Boolean  @default(false) @map("is_hidden")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("workspace_custom_fields")
}

model MembershipPlan {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  nameEn        String?  @map("name_en")
  description   String?  @db.Text
  descriptionEn String?  @db.Text @map("description_en")
  price         Int      @default(0)
  billingCycle  String   @default("monthly") @map("billing_cycle")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  isHighlighted Boolean  @default(false) @map("is_highlighted")
  contactSales  Boolean  @default(false) @map("contact_sales")
  quotaLimits   Json?    @map("quota_limits")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  payments   Payment[]

  @@map("membership_plans")
}

model Payment {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  workspaceId String   @map("workspace_id")
  planId      String   @map("plan_id")
  amount      Int
  currency    String   @default("VND")
  orderCode   String?  @unique @map("order_code")
  checkoutUrl String?  @db.Text @map("checkout_url")
  provider    String   @default("payos")
  status      String   @default("pending")
  paidAt      DateTime? @map("paid_at")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([workspaceId])
  @@index([status])
  @@index([orderCode])
  @@map("payments")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        String   @default("viewer")
  joinedAt    DateTime @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Document {
  id               String   @id @default(uuid())
  title            String
  type             String   @default("contract")
  status           String   @default("draft")
  visibility       String   @default("workspace") @db.VarChar(20) // 'private' | 'workspace'
  contentJSON      Json?    @map("content_json")
  metadata         Json?
  mergeFieldValues Json?    @map("merge_field_values")
  templateId       String?  @map("template_id")
  workspaceId      String   @map("workspace_id")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator      User             @relation("DocumentCreator", fields: [createdBy], references: [id])
  template     Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions     DocumentVersion[]
  chatMessages ChatMessage[]
  files        File[]

  // F7: Project and Hierarchy relations
  projectId        String?          @map("project_id")
  parentId         String?          @map("parent_id")
  folderId         String?          @map("folder_id")
  
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent           Document?        @relation("DocumentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Document[]       @relation("DocumentHierarchy")
  folder           ProjectFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  
  incomingLinks    DocumentLink[]   @relation("TargetDocument")
  outgoingLinks    DocumentLink[]   @relation("SourceDocument")
  clauseMappings   ClauseMapping[]  @relation("SourceClauseDoc")
  targetMappings   ClauseMapping[]  @relation("TargetClauseDoc")
  mismatchAlerts   MismatchAlert[]
  obligations      Obligation[]
  tabularCells     TabularCell[]

  @@index([workspaceId])
  @@index([createdBy])
  @@index([templateId])
  @@index([visibility])
  @@index([projectId])
  @@index([parentId])
  @@index([folderId])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  contentJSON Json?    @map("content_json")
  mergeFieldValues Json? @map("merge_field_values")
  chatCursorAt DateTime? @map("chat_cursor_at")
  label       String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([createdBy])
  @@map("document_versions")
}

model Template {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  category    String   @default("general")
  scope       String   @default("system")
  contentJSON Json?    @map("content_json")
  mergeFields Json?    @map("merge_fields")
  metadata    Json?
  s3Key       String?  @map("s3_key")
  fileName    String?  @map("file_name")
  fileSize    Int?     @map("file_size")
  mimeType    String?  @map("mime_type")
  workspaceId String?  @map("workspace_id")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  documents Document[]
  creator   User?      @relation("TemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdBy])
  @@index([workspaceId])
  @@index([scope, workspaceId])
  @@map("templates")
}

enum FileCategory {
  input_upload
  template
  export_output
}

model File {
  id          String   @id @default(uuid())
  name        String
  size        Int
  mimeType    String   @map("mime_type")
  s3Key       String   @db.Text @map("s3_key")
  category    FileCategory @default(input_upload)
  documentId  String?  @map("document_id")
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at")

  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([documentId])
  @@index([workspaceId])
  @@index([userId])
  @@map("files")
}

model Source {
  id              String   @id @default(uuid())
  title           String
  type            String   @default("pdf")
  status          String   @default("pending")
  scope           String   @default("workspace") // 'workspace' | 'system' | 'premium'
  s3Key           String?  @db.Text @map("s3_key")
  sourceUrl       String?  @db.Text @map("source_url")
  size            Int      @default(0)
  content         String?  @db.LongText
  pageCount       Int?     @map("page_count")
  chunkCount      Int?     @map("chunk_count")
  processingError String?  @db.Text @map("processing_error")
  tags            Json?
  workspaceId     String?  @map("workspace_id")
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks    SourceChunk[]

  @@index([workspaceId])
  @@index([userId])
  @@index([scope])
  @@map("sources")
}

model SourceChunk {
  id         String   @id @default(uuid())
  sourceId   String   @map("source_id")
  parentId   String?  @map("parent_id")
  content    String   @db.LongText
  pageNumber Int?     @map("page_number")
  chunkIndex Int      @map("chunk_index")
  tokenCount Int      @default(0) @map("token_count")
  embedding  Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  source   Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  parent   SourceChunk? @relation("ChunkHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children SourceChunk[] @relation("ChunkHierarchy")

  @@index([sourceId])
  @@index([parentId])
  @@map("source_chunks")
}

model ChatMessage {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  role       String
  content    String   @db.LongText
  metadata   Json?
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@map("chat_messages")
}

model ContactSubmission {
  id          String   @id @default(uuid())
  type        String   // 'sales_inquiry' | 'feedback' | 'bug_report' | 'support_request'
  name        String
  email       String
  phone       String?
  company     String?
  title       String?  // for help types
  description String   @db.Text
  status      String   @default("pending") // 'pending' | 'processed' | 'archived'
  attachments Json?    // [{ filename, s3Key }]
  userId      String?  @map("user_id") // null for public contact form
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

model UserCustomField {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  key          String   @db.VarChar(80)
  label        String
  defaultValue String?  @db.Text @map("default_value")
  isHidden     Boolean  @default(false) @map("is_hidden")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_custom_fields")
}

model UserCredit {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  aiCreditsUsed       Int      @default(0) @map("ai_credits_used")
  aiCreditsLimit      Int      @default(100) @map("ai_credits_limit")
  renewalStartedAt   DateTime @map("renewal_started_at")
  aiCreditsUsedToday  Int      @default(0) @map("ai_credits_used_today")
  aiCreditsUsedDate   DateTime? @map("ai_credits_used_date")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credits")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  subject     String   @db.VarChar(300)
  bodyHtml    String   @db.LongText @map("body_html")
  variables   Json?    // ["toName", "workspaceName", ...] - danh sách biến có thể dùng {{var}}
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@map("email_templates")
}

model PublicShare {
  id             String    @id @default(uuid())
  token          String    @unique @db.VarChar(200)
  accessCodeHash String    @map("access_code_hash") @db.VarChar(200)
  recipientEmail String    @map("recipient_email")
  title          String?
  snapshotKey    String    @map("snapshot_key")
  createdBy      String?   @map("created_by")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  otps     PublicShareOtp[]
  sessions PublicShareSession[]

  @@index([token])
  @@index([recipientEmail])
  @@map("public_shares")
}

model PublicShareOtp {
  id          String    @id @default(uuid())
  shareId     String    @map("share_id")
  email       String
  otpHash     String    @map("otp_hash") @db.VarChar(200)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  attemptCount Int      @default(0) @map("attempt_count")
  createdAt   DateTime  @default(now()) @map("created_at")

  share PublicShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, email])
  @@map("public_share_otps")
}

model PublicShareSession {
  id               String    @id @default(uuid())
  shareId          String    @map("share_id")
  email            String
  sessionTokenHash String    @map("session_token_hash") @db.VarChar(200)
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  share PublicShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, email])
  @@map("public_share_sessions")
}

model TabularReview {
  id            String    @id @default(uuid())
  projectId     String?   @map("project_id")
  userId        String    @map("user_id")
  workspaceId   String    @map("workspace_id")
  title         String?
  columnsConfig Json?     @map("columns_config")
  documentIds   Json?     @map("document_ids")
  workflowId    String?   @map("workflow_id")
  practice      String?
  sharedWith    Json?     @map("shared_with")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cells         TabularCell[]
  chats         TabularReviewChat[]

  @@map("tabular_reviews")
}

model TabularCell {
  id          String   @id @default(uuid())
  reviewId    String   @map("review_id")
  documentId  String   @map("document_id")
  columnIndex Int      @map("column_index")
  content     String?  @db.Text
  citations   Json?
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")

  review      TabularReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  document    Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("tabular_cells")
}

model TabularReviewChat {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review    TabularReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  messages  TabularReviewChatMessage[]

  @@map("tabular_review_chats")
}

model TabularReviewChatMessage {
  id          String   @id @default(uuid())
  chatId      String   @map("chat_id")
  role        String
  content     Json?
  annotations Json?
  createdAt   DateTime @default(now()) @map("created_at")

  chat        TabularReviewChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("tabular_review_chat_messages")
}

model LpmsWorkflow {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  title         String
  type          String
  promptMd      String?  @db.Text @map("prompt_md")
  columnsConfig Json?    @map("columns_config")
  practice      String?
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("lpms_workflows")
}

model LpmsWorkflowShare {
  id              String   @id @default(uuid())
  workflowId      String   @map("workflow_id")
  sharedWithEmail String   @map("shared_with_email")
  allowEdit       Boolean  @default(false) @map("allow_edit")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("lpms_workflow_shares")
}

model LpmsHiddenWorkflow {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  workflowId String   @map("workflow_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, workflowId])
  @@map("lpms_hidden_workflows")
}

model Project {
  id           String      @id @default(uuid())
  workspaceId  String      @map("workspace_id")
  createdBy    String?     @map("created_by")
  name         String
  code         String      @map("code")
  description  String?     @db.Text
  sharedWith   Json?       @map("shared_with")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents      Document[]
  tabularReviews TabularReview[]
  lpmsChats      LpmsChat[]
  folders        ProjectFolder[]

  @@unique([workspaceId, code])
  @@map("projects")
}

model ProjectFolder {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  userId         String   @map("user_id")
  name           String
  parentFolderId String?  @map("parent_folder_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   ProjectFolder? @relation("ProjectFolderTree", fields: [parentFolderId], references: [id], onDelete: SetNull)
  children ProjectFolder[] @relation("ProjectFolderTree")
  documents Document[]

  @@map("project_folders")
}

model LpmsChat {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  projectId   String?  @map("project_id")
  userId      String   @map("user_id")
  title       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    LpmsChatMessage[]

  @@map("lpms_chats")
}

model LpmsChatMessage {
  id          String   @id @default(uuid())
  chatId      String   @map("chat_id")
  role        String
  content     Json?
  annotations Json?
  createdAt   DateTime @default(now()) @map("created_at")

  chat        LpmsChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("lpms_chat_messages")
}

model DocumentLink {
  id               String   @id @default(uuid())
  sourceDocumentId String   @map("source_document_id")
  targetDocumentId String   @map("target_document_id")
  linkType         String   // 'dependency' | 'data_inheritance' | 'reference'
  description      String?  @db.Text
  status           String   @default("active") // 'active' | 'broken' | 'out_of_sync'
  createdAt        DateTime @default(now()) @map("created_at")

  sourceDocument   Document @relation("SourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocument   Document @relation("TargetDocument", fields: [targetDocumentId], references: [id], onDelete: Cascade)

  @@unique([sourceDocumentId, targetDocumentId, linkType])
  @@map("document_links")
}

model ClauseMapping {
  id              String    @id @default(uuid())
  sourceDocId     String    @map("source_doc_id")
  targetDocId     String    @map("target_doc_id")
  sourceClauseId  String    @map("source_clause_id")
  targetClauseId  String    @map("target_clause_id")
  sourceClauseKey String    @map("source_clause_key")
  targetClauseKey String    @map("target_clause_key")
  mappingType     String    // 'supersedes' | 'modifies' | 'extends'
  status          String    @default("active")
  effectiveDate   DateTime? @map("effective_date")
  createdAt       DateTime  @default(now()) @map("created_at")

  sourceDoc       Document  @relation("SourceClauseDoc", fields: [sourceDocId], references: [id], onDelete: Cascade)
  targetDoc       Document  @relation("TargetClauseDoc", fields: [targetDocId], references: [id], onDelete: Cascade)

  @@index([sourceDocId])
  @@index([targetDocId])
  @@map("clause_mappings")
}

model MismatchAlert {
  id            String   @id @default(uuid())
  documentId    String   @map("document_id")
  fieldKey      String   @map("field_key")
  sourceValue   String   @db.Text @map("source_value")
  mismatchValue String   @db.Text @map("mismatch_value")
  severity      String   @default("medium")
  description   String   @db.Text
  status        String   @default("unresolved")
  createdAt     DateTime @default(now()) @map("created_at")

  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("mismatch_alerts")
}

model Obligation {
  id                String    @id @default(uuid())
  documentId        String    @map("document_id")
  workspaceId       String    @map("workspace_id")
  picId             String?   @map("pic_id")
  title             String    @db.VarChar(255)
  description       String?   @db.Text
  status            String    @default("pending") // 'pending' | 'in_progress' | 'completed' | 'overdue' | 'escalated'
  dueDate           DateTime  @map("due_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Nhóm thuộc tính tài chính
  amount            Decimal?  @db.Decimal(15, 2)
  percentage        Float?
  triggerCondition  String?   @db.Text @map("trigger_condition")

  // Nhóm thuộc tính phi tài chính
  obligationType    String?   @map("obligation_type") // 'warranty' | 'inspection' | 'delivery' | 'other'
  effectivePeriod   String?   @db.VarChar(255) @map("effective_period")
  responsibleVendor String?   @db.VarChar(255) @map("responsible_vendor")

  // Trạng thái nhắc nhở / lưu vết để không spam email
  notifiedStages    Json      @default("[]") @map("notified_stages") // e.g. ["30_days", "15_days", "7_days", "due_date", "overdue"]

  // Quan hệ liên kết
  document          Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([workspaceId])
  @@index([status])
  @@map("obligations")
}

